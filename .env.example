# lmstudio | openai | openrouter | groq | xai | custom
LLM_PROVIDER=lmstudio
# Optional for LM Studio. Required for cloud providers. Do not leave lm-studio here if you switch away from local.
LLM_API_KEY=
# Leave empty for LM Studio to use the first loaded chat model.
LLM_MODEL=
# Seconds to wait for a generation. Unset = 600 local, 120 cloud.
# LLM_TIMEOUT=600

# OpenAI
# LLM_PROVIDER=openai
# LLM_API_KEY=sk-...
# LLM_MODEL=gpt-4o-mini

# OpenRouter
# LLM_PROVIDER=openrouter
# LLM_API_KEY=sk-or-...
# LLM_MODEL=openai/gpt-4o-mini

# Groq
# LLM_PROVIDER=groq
# LLM_API_KEY=gsk_...
# LLM_MODEL=llama-3.3-70b-versatile

# xAI
# LLM_PROVIDER=xai
# LLM_API_KEY=xai-...
# LLM_MODEL=grok-3

# Any other OpenAI-compatible /v1 host
# LLM_PROVIDER=custom
# LLM_BASE_URL=https://your-host/v1
# LLM_API_KEY=
# LLM_MODEL=your-model

# Local data (profile JSON, SQLite, uploads)
# Docker Compose overrides this to /data (bind-mounted to ./data).
DATA_DIR=./data
