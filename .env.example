# Example only. Copy to .env and edit that file — do not commit secrets.
#   cp .env.example .env
#
# lmstudio | openai | openrouter | groq | xai | custom
LLM_PROVIDER=lmstudio
# Optional for LM Studio (empty is fine; the app sends lm-studio to the local server).
# Required for openai, openrouter, groq, and xai. A leftover lm-studio value is not a cloud key.
LLM_API_KEY=
# Leave empty when LLM_PROVIDER=lmstudio to use the first loaded chat model.
# Cloud providers and a remote custom host require a model id.
LLM_MODEL=
# Seconds to wait for a generation. 600 matches LM Studio; cloud presets use 120 if you omit this.
LLM_TIMEOUT=600
# Only for LLM_PROVIDER=custom. Omit for lmstudio (uses http://127.0.0.1:1234/v1).
# A leftover localhost URL is ignored when LLM_PROVIDER is a cloud preset.
# LLM_BASE_URL=

# OpenAI
# LLM_PROVIDER=openai
# LLM_API_KEY=sk-...
# LLM_MODEL=gpt-4o-mini

# OpenRouter
# LLM_PROVIDER=openrouter
# LLM_API_KEY=sk-or-...
# LLM_MODEL=openai/gpt-4o-mini

# Groq
# LLM_PROVIDER=groq
# LLM_API_KEY=gsk_...
# LLM_MODEL=llama-3.3-70b-versatile

# xAI
# LLM_PROVIDER=xai
# LLM_API_KEY=xai-...
# LLM_MODEL=grok-3

# Any other OpenAI-compatible /v1 host
# LLM_PROVIDER=custom
# LLM_BASE_URL=https://your-host/v1
# LLM_API_KEY=
# LLM_MODEL=your-model

# Local data (profile JSON, SQLite, uploads)
# Docker Compose overrides this to /data (bind-mounted to ./data).
DATA_DIR=./data
