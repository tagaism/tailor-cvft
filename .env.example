# LM Studio OpenAI-compatible server
# Developer tab → Start server (default port 1234) and load a model.
LLM_BASE_URL=http://127.0.0.1:1234/v1
LLM_API_KEY=lm-studio
# Leave empty to use the first chat model LM Studio reports.
LLM_MODEL=
# Seconds to wait for a local generation (Gemma can exceed 3 minutes).
LLM_TIMEOUT=600

# Local data (profile JSON, SQLite, uploads)
# Docker Compose overrides this to /data (bind-mounted to ./data).
DATA_DIR=./data
